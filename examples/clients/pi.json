{
  "mcpServers": {
    "allsearch": {
      "type": "stdio",
      "exposure": "direct",
      "command": "/path/to/allsearch/.venv/bin/allsearch",
      "args": ["--transport", "stdio", "--log-level", "WARNING"],
      "timeout": 180,
      "env": {
        "ALLSEARCH_ENV_FILE": "/path/to/allsearch/.env"
      }
    }
  }
}
