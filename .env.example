# AllSearch configuration (placeholders only — never commit real keys)

# --- Core / MCP ---
ALLSEARCH_SERVER_NAME=AllSearch
ALLSEARCH_LOG_LEVEL=INFO
ALLSEARCH_TRANSPORT=stdio
ALLSEARCH_MCP_HOST=127.0.0.1
ALLSEARCH_MCP_PORT=8000
ALLSEARCH_MCP_PATH=/mcp
ALLSEARCH_MCP_STATELESS_HTTP=false
ALLSEARCH_TIMEOUT_SECONDS=30
ALLSEARCH_TOTAL_BUDGET_SECONDS=45
ALLSEARCH_MAX_CONCURRENCY=4
ALLSEARCH_MAX_RESPONSE_BYTES=33554432

# When false (default), search fails with primary_unavailable if xAI is missing.
ALLSEARCH_ALLOW_DEGRADED_SEARCH=false

# --- xAI / Grok (primary) ---
# Official xAI Responses endpoint; replace with another compatible endpoint if needed.
ALLSEARCH_XAI_API_KEY=
ALLSEARCH_XAI_BASE_URL=https://api.x.ai/v1
ALLSEARCH_XAI_RESPONSES_PATH=/responses
# Example primary/fallback models; use aliases available on your endpoint.
ALLSEARCH_XAI_MODEL=grok-4.5
# Optional same-endpoint model fallback. Set to none to skip it and go directly
# to ALLSEARCH_XAI_FALLBACK_* endpoint on primary failure.
ALLSEARCH_XAI_FALLBACK_MODELS=grok-4.3
ALLSEARCH_XAI_REASONING_EFFORT=low
ALLSEARCH_XAI_ALLOWED_MODELS=grok-4.5,grok-4.3,grok-3-mini-fast,grok-composer-2.5-fast,grok-4.20-fast,grok-4.20-0309-non-reasoning,grok-4.20-0309-reasoning
# Hard cap for server-side search/tool calls per Responses request.
ALLSEARCH_XAI_MAX_TOOL_CALLS=4

# --- xAI endpoint-level fallback (optional) ---
# A second xAI-compatible endpoint used when the primary Responses endpoint fails
# (402 balance exhausted / 429 rate-limit / 5xx / auth). For OpenAI-compatible
# chat gateways, set base_url with /v1 suffix and protocol=openai.
# protocol is openai-only (chat completions); "responses" is rejected at config load.
# Note: many OpenAI-compatible gateways mis-handle reasoning_effort (empty content);
# set ALLSEARCH_XAI_FALLBACK_REASONING_EFFORT=none unless you have verified support.
# ALLSEARCH_XAI_FALLBACK_BASE_URL=https://fallback.example/v1
# ALLSEARCH_XAI_FALLBACK_API_KEY=
# ALLSEARCH_XAI_FALLBACK_CHAT_PATH=/chat/completions
# ALLSEARCH_XAI_FALLBACK_MODEL=grok-4.3-fast
# ALLSEARCH_XAI_FALLBACK_PROTOCOL=openai
# ALLSEARCH_XAI_FALLBACK_REASONING_EFFORT=none

# --- Tavily (supplement) ---
# Primary key (single-key mode, kept for backwards compatibility):
ALLSEARCH_TAVILY_API_KEY=
# Optional key rotation pool — comma-separated additional keys. The provider rotates
# round-robin across primary + pool keys and parks a key for 60s on quota/rate-limit.
ALLSEARCH_TAVILY_API_KEYS=
ALLSEARCH_TAVILY_BASE_URL=https://api.tavily.com
ALLSEARCH_TAVILY_SEARCH_PATH=/search
ALLSEARCH_TAVILY_DEFAULT_DEPTH=basic
ALLSEARCH_TAVILY_MAX_RESULTS=8

# --- AnySearch (vertical supplement) ---
ALLSEARCH_ANYSEARCH_API_KEY=
ALLSEARCH_ANYSEARCH_ENDPOINT=https://api.anysearch.com/mcp
ALLSEARCH_ANYSEARCH_ENABLED=true
ALLSEARCH_ANYSEARCH_VERTICALS=general,resource,social_media,finance,academic,legal,health,business,security,ip,code,energy,environment,agriculture,travel,film,gaming
ALLSEARCH_ANYSEARCH_DIRECTORY_TTL_SECONDS=86400
ALLSEARCH_ANYSEARCH_MAX_RESULTS=8

# --- Firecrawl (known-URL extract assist) ---
ALLSEARCH_FIRECRAWL_API_KEY=
ALLSEARCH_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
ALLSEARCH_FIRECRAWL_SCRAPE_PATH=/v2/scrape
ALLSEARCH_FIRECRAWL_ONLY_MAIN_CONTENT=true
ALLSEARCH_FIRECRAWL_MAX_PAGES=3

# --- Cache / reliability ---
ALLSEARCH_SEARCH_CACHE_TTL_SECONDS=120
ALLSEARCH_NEWS_CACHE_TTL_SECONDS=30
ALLSEARCH_FETCH_CACHE_TTL_SECONDS=900
ALLSEARCH_CACHE_MAX_ENTRIES=512
ALLSEARCH_CACHE_BACKEND=memory
ALLSEARCH_HEALTH_PROBE_TTL_SECONDS=300
ALLSEARCH_CIRCUIT_FAILURE_THRESHOLD=3
ALLSEARCH_CIRCUIT_OPEN_SECONDS=60
ALLSEARCH_MIN_PRIMARY_CITATIONS=3
ALLSEARCH_MIN_UNIQUE_DOMAINS=2
ALLSEARCH_AUTO_SCRAPE_TOP_N=0

# Opt-in live tests only (CI stays offline)
ALLSEARCH_RUN_LIVE_TESTS=0
